        { "cmd": "codex app-server --help", "timeoutMs": 20000 },
        { "cmd": "codex app-server", "timeoutMs": 15000,
          "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"coda-probe\",\"version\":\"0.0.1\"}}}\n" }
      ] },
