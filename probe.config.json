{
  "schemaVersion": 1,
  "agents": [
    { "id": "claude", "package": "@anthropic-ai/claude-code", "bin": "claude",
      "commands": [
        { "cmd": "claude --version", "timeoutMs": 20000 },
        { "cmd": "claude --help", "timeoutMs": 20000 },
        { "cmd": "claude -p --help", "timeoutMs": 20000 }
      ] },
