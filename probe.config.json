{
  "schemaVersion": 1,
  "agents": [
    {
      "id": "claude",
      "package": "@anthropic-ai/claude-code",
      "bin": "claude",
      "commands": [
        {
          "cmd": "claude --version",
          "timeoutMs": 20000
        },
        {
          "cmd": "claude --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "claude -p --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "claude -p --output-format stream-json --input-format stream-json --verbose --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "claude -p --output-format stream-json --verbose \"Reply with exactly one word: pong\"",
          "timeoutMs": 60000
        }
      ]
    },
    {
      "id": "codex",
      "package": "@openai/codex",
      "bin": "codex",
      "commands": [
        {
          "cmd": "codex --version",
          "timeoutMs": 20000
        },
        {
          "cmd": "codex --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "codex app-server --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "codex app-server",
          "timeoutMs": 15000,
          "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"coda-probe\",\"version\":\"0.0.1\"}}}\n"
        },
        {
          "cmd": "codex exec --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "codex app-server generate-json-schema --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "codex app-server generate-json-schema",
          "timeoutMs": 90000
        },
        {
          "cmd": "codex app-server generate-ts --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "codex exec --json --skip-git-repo-check \"Reply with exactly one word: pong\"",
          "timeoutMs": 90000
        },
        {
          "cmd": "codex app-server generate-json-schema --out /tmp/probe-out/codex-schema",
          "timeoutMs": 120000,
          "captureDir": "/tmp/probe-out/codex-schema",
          "captureFull": true
        }
      ]
    },
    {
      "id": "gemini",
      "package": "@google/gemini-cli",
      "bin": "gemini",
      "commands": [
        {
          "cmd": "gemini --version",
          "timeoutMs": 20000
        },
        {
          "cmd": "gemini --help",
          "timeoutMs": 20000
        },
        {
          "cmd": "gemini --acp",
          "timeoutMs": 20000,
          "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientCapabilities\":{\"fs\":{\"readTextFile\":false,\"writeTextFile\":false}},\"clientInfo\":{\"name\":\"coda-probe\",\"version\":\"0.0.1\"}}}\n"
        },
        {
          "cmd": "gemini --acp",
          "timeoutMs": 25000,
          "stdinLines": [
            "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientCapabilities\":{\"fs\":{\"readTextFile\":false,\"writeTextFile\":false}},\"clientInfo\":{\"name\":\"coda-probe\",\"version\":\"0.0.1\"}}}",
            "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"session/new\",\"params\":{\"cwd\":\"/tmp\",\"mcpServers\":[]}}"
          ]
        },
        {
          "cmd": "gemini --acp",
          "timeoutMs": 60000,
          "acpFlow": {
            "prompt": "Reply with exactly one word: pong",
            "timeoutMs": 50000
          }
        }
      ]
    },
